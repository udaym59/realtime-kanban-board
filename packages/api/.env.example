# Neon pooled URL (runtime queries) — PgBouncer, cannot run migrations
DATABASE_URL="postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# Neon direct URL (migrations + LISTEN subscriber — bypass PgBouncer)
DIRECT_URL="postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# Single public demo board — created by `pnpm db:seed`
# Any valid v4 UUID; keep stable so the web client always points at the right board
DEMO_BOARD_ID="00000000-0000-4000-a000-000000000001"

PORT=3001
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL="info"
