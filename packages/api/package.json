{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev": "tsx watch src/index.ts",
    "smoke:create": "tsx scripts/smoke-create.ts",
    "smoke:move": "tsx scripts/smoke-move.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke:edit": "tsx scripts/smoke-edit.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "fractional-indexing": "^3.2.0",
    "pg": "^8.14.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "shared": "workspace:*",
    "socket.io": "^4.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.11",
    "pino-pretty": "^11.3.0",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.0"
  }
}
